graph TB
    subgraph Internet[Internet]
        Users[Usuarios/Visitantes]
        DiscordAPI[API de Discord]
    end

    subgraph Cloudflare[Capa Cloudflare]
        CFTunnel[Cloudflare Tunnel]
        DNS[Registros DNS]
    end

    subgraph Router[Red Domestica]
        RouterBox[Router/Modem]
    end

    subgraph Laptop[Laptop Gamer Windows]
        subgraph OS[Capa de Sistema Operativo]
            WSL2[WSL2 Ubuntu 22.04]
        end

        subgraph ReverseProxy[Proxy Inverso]
            Caddy[Caddy Server<br/>Puerto 80/443<br/>HTTPS Automatico]
        end

        subgraph Apps[Capa de Aplicaciones]
            Bot[Discord Bot<br/>Node.js/Python<br/>Puerto 3001]
            Site1[SvelteKit Sitio 1<br/>Puerto 3002]
            Site2[SvelteKit Sitio 2<br/>Puerto 3003]
        end

        subgraph Analytics[Analiticas]
            Umami[Umami/Plausible<br/>Puerto 3004]
            DB[(PostgreSQL<br/>Puerto 5432)]
        end

        subgraph Management[Herramientas de Gestion]
            PM2[PM2 Process Manager<br/>Monitoreo + Restart]
            Docker[Docker Engine<br/>Contenedores]
        end
    end

    Users -->|HTTPS| DNS
    DNS --> CFTunnel
    CFTunnel -->|Tunnel Cifrado| Caddy

    DiscordAPI <-->|WebSocket| Bot

    Caddy -->|Proxy /| Site1
    Caddy -->|Proxy /app2| Site2
    Caddy -->|Proxy /analytics| Umami

    Site1 -.->|Eventos de Tracking| Umami
    Site2 -.->|Eventos de Tracking| Umami

    Umami --> DB

    PM2 -.->|Gestiona| Bot
    PM2 -.->|Gestiona| Site1
    PM2 -.->|Gestiona| Site2

    Docker -.->|Ejecuta| Umami
    Docker -.->|Ejecuta| DB

    RouterBox -.->|Red Local| Laptop

